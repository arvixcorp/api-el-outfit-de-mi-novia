# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# Los valores de abajo asumen servicios instalados localmente (sin Docker).

# --- Servidor ---
NODE_ENV=development
PORT=3000
# Origenes permitidos por CORS, separados por coma ("*" solo en desarrollo)
CORS_ORIGINS=*

# --- Base de datos (MySQL) ---
# Opcion A: una sola URL
DATABASE_URL=mysql://outfit:outfit@localhost:3306/outfit
# Opcion B: variables separadas (se usan solo si DATABASE_URL esta vacia o no existe)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASENAME=outfit
# MYSQL_USER=outfit
# MYSQL_PASSWORD=outfit

# --- Auth (JWT con refresh token) ---
# Genera secretos largos: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-32-caracteres-o-mas
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Almacenamiento: AWS S3 ---
# Para AWS S3 deja S3_ENDPOINT vacio.
S3_ENDPOINT=
# Region del bucket, p. ej. us-east-1
S3_REGION=us-east-1
S3_BUCKET=nombre-de-tu-bucket
# Credenciales de un usuario IAM con permisos s3:PutObject, s3:GetObject, s3:DeleteObject sobre el bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Siempre false para AWS S3
S3_FORCE_PATH_STYLE=false
# URL base publica para leer imagenes (opcional; si no se define se usan URLs prefirmadas)
S3_PUBLIC_URL=

# --- Eliminacion de fondo ---
# rembg = servicio autohospedado; external = API externa
BG_REMOVAL_PROVIDER=rembg
REMBG_URL=http://localhost:7000
# Solo si BG_REMOVAL_PROVIDER=external
BG_REMOVAL_EXTERNAL_URL=
BG_REMOVAL_EXTERNAL_API_KEY=
# Header de la clave, campo de la imagen y campos extra (la respuesta debe ser la imagen con transparencia)
BG_REMOVAL_EXTERNAL_KEY_HEADER=x-api-key
BG_REMOVAL_EXTERNAL_FIELD=image_file
BG_REMOVAL_EXTERNAL_FORM=
# Ejemplo rembg.com:  URL=https://api.rembg.com/rmbg  FIELD=image  FORM=format=PNG
# Ejemplo remove.bg:  URL=https://api.remove.bg/v1.0/removebg  FIELD=image_file  FORM=(vacio)

# --- IA: etiquetado de prendas (con imagen) y recomendacion de outfits ---
# Proveedor: deepseek (por defecto) | anthropic
AI_PROVIDER=deepseek
# Clave de https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Vacio = modelo por defecto del proveedor (deepseek: deepseek-flash). Alternativa: deepseek-v4-pro
AI_MODEL=
# true activa el razonamiento del modelo: mas lento y caro, no hace falta para este uso
AI_THINKING=false
# Solo si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Limite diario de llamadas a la IA por usuaria
AI_DAILY_LIMIT=30

# --- Worker de procesamiento (corre dentro de la API; cola en MySQL) ---
WORKER_ENABLED=true
WORKER_POLL_MS=3000
WORKER_MAX_ATTEMPTS=3
